# Copy this to .env and fill in your own values. Never commit .env.
# Generate a secret with: python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=change-me-to-a-long-random-value
HOST=127.0.0.1
PORT=5000

# Admin panel: set this in Render > Environment. The admin panel is disabled
# until ADMIN_PASSWORD is set. Never put a real admin password in the repo.
ADMIN_USERNAME=admin
# ADMIN_PASSWORD=choose-a-strong-admin-password

# Optional: only needed if you want fraud-alert emails.
# Use a fresh Gmail app password, never the one from the original upload.
# SENDER_EMAIL=you@example.com
# SENDER_PASS=
